{
  "functions": {
    "api/ia.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/enem-pdf/:file(202[0-6]_(?:PV|GB)_impresso_D(?:1_CD1|2_CD7)\\.pdf)",
      "destination": "https://download.inep.gov.br/enem/provas_e_gabaritos/:file"
    }
  ]
}
